rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helpers ---
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == 'raghadalzeer60@gmail.com')
      ); 
    }
    
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Entity Validators ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['role', 'createdAt'])
        && data.role in ['customer', 'admin']
        && (data.createdAt is timestamp || data.createdAt is string) 
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100));
    }
    
    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && (data.createdAt is timestamp || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }
    
    function isValidMenuItem(data) {
      return data.keys().hasAll(['categoryId', 'name', 'price', 'createdAt'])
        && data.categoryId is string && data.categoryId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && (data.createdAt is timestamp || data.createdAt is string)
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }
    
    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['pending', 'paid', 'completed', 'cancelled']
        && (data.createdAt is timestamp || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }
    
    function isValidReservation(data) {
      return data.keys().hasAll(['userId', 'date', 'time', 'guests', 'status', 'createdAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.date is string && data.date.size() <= 20
        && data.time is string && data.time.size() <= 10
        && data.guests is number && data.guests > 0 && data.guests <= 100
        && data.status in ['pending', 'confirmed', 'cancelled']
        && (data.createdAt is timestamp || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string);
    }
    
    function isValidRestaurantInfo(data) {
      return data.keys().hasAll(['name', 'phone', 'location', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.location is string && data.location.size() <= 200
        && (data.updatedAt is timestamp || data.updatedAt is string);
    }
    
    function isValidSubscription(data) {
      return data.keys().hasAll(['type', 'updatedAt'])
        && data.type in ['free', 'paid']
        && (data.updatedAt is timestamp || data.updatedAt is string);
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId 
        && isValidUser(incoming())
        && (incoming().role == 'customer' || (incoming().role == 'admin' && request.auth.token.email == 'raghadalzeer60@gmail.com'));
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['phoneNumber', 'updatedAt'])) ||
        isAdmin()
      );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(menuItemId) && isValidMenuItem(incoming());
      allow update: if isAdmin() && isValidId(menuItemId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'imageUrl', 'categoryId', 'updatedAt']) && isValidMenuItem(incoming());
      allow delete: if isAdmin() && isValidId(menuItemId);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        (request.auth.uid == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled') ||
        isAdmin()
      );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /reservations/{reservationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(reservationId) && isValidReservation(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(reservationId) && isValidReservation(incoming()) && (
        (request.auth.uid == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled') ||
        isAdmin()
      );
      allow delete: if isAdmin() && isValidId(reservationId);
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && (
        (docId == 'restaurantInfo' && isValidRestaurantInfo(incoming())) ||
        (docId == 'subscription' && isValidSubscription(incoming()))
      );
      allow delete: if false;
    }
  }
}
